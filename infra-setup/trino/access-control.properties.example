# Minimum-necessary access control (opt-in).
#
# This is NOT active by default — enabling it changes Trino's default posture
# from "wide open" to "default-deny, rules decide", which is safer for a
# healthcare-shaped platform but is worth reviewing rather than silently
# switching on for anyone just trying the stack. To enable:
#
#   cp access-control.properties.example access-control.properties
#   docker compose restart trino
#
# See rules.json for the actual rules (mirrors the role matrix in
# governance/phi_classification.yml) and ../../docs/hipaa_alignment.md for
# how this fits the platform's overall posture.

access-control.name=file
security.config-file=/etc/trino/rules.json
security.refresh-period=5s
